{
  "name": "transitlog-server",
  "version": "1.1.0",
  "private": true,
  "description": "Server component for Transitlog and Bultti.",
  "main": "src/server.ts",
  "scripts": {
    "docker:build": "docker build --cpuset-cpus 2 -t hsldevcom/transitlog-server .",
    "docker:run": "docker run --name transitlog-server -p 4000:4000 hsldevcom/transitlog-server",
    "start": "TS_NODE_FILES=true NODE_ICU_DATA=\\\"node_modules/full-icu\\\" ts-node-dev --max-old-space-size=4096 --no-notify --respawn --inspect -r dotenv/config --files src/server.ts",
    "start:build": "TS_NODE_FILES=true NODE_ICU_DATA=\"node_modules/full-icu\" ts-node-dev --no-notify --respawn --inspect -r dotenv/config --files dist/server.js",
    "start:production": "NODE_ICU_DATA=\"node_modules/full-icu\" node -r dotenv/config dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "codegen": "graphql-codegen --config codegen.yml",
    "codestyle": "prettier \"src/**/*.{ts,js,json}\" --write",
    "test": "node scripts/test.js",
    "test:ci": "CI=true node scripts/test.js",
    "test:staged": "CI=true node scripts/test.js --bail --findRelatedTests --passWithNoTests",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "lint-staged": {
    "*.{ts,js}": [
      "tslint --fix",
      "prettier --write",
      "yarn run test:staged",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "author": "HSLdevcom",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/utils.keyvaluecache": "^4.0.0",
    "@as-integrations/express4": "^1.1.2",
    "@azure/storage-blob": "^12.32.0",
    "@slack/web-api": "^7.16.0",
    "apollo-datasource": "^0.3.1",
    "apollo-link": "^1.2.9",
    "apollo-link-context": "^1.0.15",
    "apollo-link-error": "^1.1.8",
    "apollo-link-http": "^1.5.12",
    "apollo-server-caching": "^0.3.1",
    "apollo-server-errors": "^2.2.1",
    "await-to-js": "^2.1.1",
    "body-parser": "^2.2.2",
    "boundingbox": "^1.2.0",
    "chalk": "^4.1.1",
    "connect-redis": "6",
    "cors": "^2.8.6",
    "dataloader": "^1.4.0",
    "date-fns": "^1.30.1",
    "dotenv": "^6.2.0",
    "express": "4.22.0",
    "express-rate-limit": "5.5.1",
    "express-react-views": "^0.11.0",
    "express-session": "^1.19.0",
    "fs-extra": "^8.0.1",
    "full-icu": "^1.3.0",
    "fuse.js": "^3.4.4",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.6",
    "ioredis": "^4.16.0",
    "isomorphic-fetch": "^3.0.0",
    "knex": "^3.2.10",
    "knex-postgis": "^0.14.3",
    "lodash": "^4.17.11",
    "lusca": "^1.7.0",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.23",
    "node-fetch": "^2.3.0",
    "p-map": "^3.0.0",
    "pg": "^8.6.0",
    "proper-url-join": "^2.0.1",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "redis": "3.1.2",
    "ts-node": "^10",
    "typescript": "^5.4",
    "uuid": "^7.0.3",
    "validator": "^13.15.20"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5",
    "@graphql-codegen/typescript": "^5",
    "@graphql-codegen/typescript-resolvers": "^5",
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.17.43",
    "@types/express-session": "^1.17.3",
    "@types/graphql": "^14.0.7",
    "@types/ioredis": "^4.0.9",
    "@types/jest": "^30",
    "@types/lodash": "^4.14.122",
    "@types/lusca": "^1.7.5",
    "@types/node": "^20",
    "@types/validator": "^13.15.4",
    "concurrently": "^4.1.0",
    "husky": "^1.3.1",
    "jest": "^30",
    "lint-staged": "^9.0.0",
    "nodemon": "^1.18.10",
    "prettier": "^2.8.8",
    "ts-jest": "^29",
    "ts-node-dev": "^1.1.6",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "tslint-plugin-prettier": "^2.0.1"
  },
  "resolutions": {
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "express": "4.22.0",
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.17.43",
    "redis": "^3.1.1",
    "node-fetch": "^2.6.7",
    "axios": "^0.32.0",
    "lodash": "^4.18.0",
    "fast-xml-parser": "^5.5.6",
    "fast-xml-builder": "^1.1.7",
    "path-to-regexp": "^0.1.13",
    "handlebars": "^4.7.9",
    "picomatch": "^4.0.4",
    "shell-quote": "^1.8.4",
    "js-cookie": "^3.0.7",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4"
  }
}
